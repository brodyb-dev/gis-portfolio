# Copy to .env and fill in. .env is git-ignored.
PGHOST=localhost
PGPORT=5432
PGDATABASE=stl_gis
PGUSER=postgres
PGPASSWORD=change-me
# Web services (M5). Leave these out and etl/09_web_roles.py generates them.
# TILES_DB_PASSWORD=
# API_DB_PASSWORD=

# Tool locations. Set these if your installs differ from the defaults shown (the defaults are
# where they live on the author's machine). Used by etl/common.py, scripts/m1-verify.ps1 and
# scripts/start.ps1.
# PG_BIN       PostgreSQL bin folder; it must hold psql.exe and ogr2ogr.exe (the PostGIS bundle)
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
# OSM2PGSQL=A:\gis-tools\osm2pgsql\osm2pgsql-bin\osm2pgsql.exe
# PG_TILESERV=A:\gis-tools\pg_tileserv\pg_tileserv.exe

# Other optional overrides:
# WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GTFS_URL=https://www.metrostlouis.org/Transit/google_transit.zip
